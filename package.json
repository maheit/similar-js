{
  "name": "similar-js",
  "version": "1.0.4",
  "description": "A rich and optimistic Javascript library to JS and JSON datatype comparison, validation and model generation",
  "type": "module",
  "main": "./dist/bundle.cjs",
  "module": "./dist/bundle.min.js",
  "browser": "./dist/SimilarJS.iife.js",
  "exports": {
    "import": "./dist/bundle.min.js",
    "require": "./dist/bundle.cjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "test": "jest",
    "format": "prettier --config ./.prettierrc.json --write src/**",
    "build": "node build.js",
    "gulp": "gulp build-js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maheit/similar-js.git"
  },
  "keywords": [
    "equals",
    "deep-equals",
    "similar",
    "deep-similar",
    "deep-comparison",
    "array-equals",
    "object-equals",
    "string-equals",
    "number-equals",
    "data-model-generator",
    "json-validator",
    "json-comparison",
    "deep-validator"
  ],
  "author": "Maheitdev",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/maheit/similar-js/issues"
  },
  "homepage": "https://github.com/maheit/similar-js#readme",
  "devDependencies": {
    "@babel/preset-env": "^7.22.5",
    "gulp": "^4.0.2",
    "gulp-concat": "^2.6.1",
    "gulp-minify": "^3.1.0",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-uglify": "^3.0.2",
    "jest": "^29.5.0",
    "prettier": "2.8.8",
    "tsc": "^2.0.4",
    "esbuild": "^0.24.0"
  },
  "dependencies": {}
}